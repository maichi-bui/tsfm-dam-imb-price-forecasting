{
  "lora_r": {
    "type": "categorical",
    "choices": [4, 8, 16, 32]
  },
  "lora_alpha": {
    "type": "categorical",
    "choices": [8, 16, 32]
  },
  "lora_dropout": {
    "type": "float",
    "low": 0.0,
    "high": 0.2,
    "step": 0.05
  },
  "lora_target_modules": {
    "type": "categorical",
    "choices": [
      ["q", "v"],
      ["q", "k", "v"],
      ["q", "k", "v", "o"]
    ]
  },
  "lr": {
    "type": "float",
    "low": 1e-5,
    "high": 2e-4,
    "log": true
  },
  "weight_decay": {
    "type": "float",
    "low": 0.0,
    "high": 0.1,
    "step": 0.01
  },
  "batch_size": {
    "type": "categorical",
    "choices": [8, 16, 32]
  },
  "context_lengths": {
    "type": "categorical",
    "choices": [
      [512, 1024, 2048],
      [1024, 2048],
      [2048],
      [8192]
    ]
  },
  "grad_clip": {
    "type": "float",
    "low": 0.5,
    "high": 2.0,
    "step": 0.5
  },
  "max_steps": {
    "type": "categorical",
    "choices": [1000, 2000, 3000]
  }
}
